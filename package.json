{
  "name": "lingua-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --filter @lingua/web dev",
    "backend:dev": "python -m uvicorn --app-dir services/api/src lingua_api.main:app --reload",
    "backend:format:check": "python -m ruff format --check services/api/src database/migrate.py tests/backend",
    "backend:lint": "python -m ruff check services/api/src database/migrate.py tests/backend",
    "backend:typecheck": "python -m mypy",
    "backend:test": "python -m pytest",
    "backend:check": "pnpm backend:format:check && pnpm backend:lint && pnpm backend:typecheck && pnpm backend:test",
    "contracts:generate": "openapi-typescript contracts/openapi.yaml --output packages/types/src/generated/openapi.ts --immutable",
    "contracts:check-generated": "openapi-typescript contracts/openapi.yaml --output packages/types/src/generated/openapi.ts --immutable --check",
    "db:migrate": "python database/migrate.py up",
    "db:rollback": "python database/migrate.py down --steps 1",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:all": "pnpm test && pnpm backend:test",
    "typecheck": "pnpm contracts:check-generated && pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "storybook": "pnpm --filter @lingua/ui storybook",
    "build-storybook": "pnpm --filter @lingua/ui build-storybook"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.1",
    "jsdom": "^26.0.0",
    "openapi-typescript": "7.9.1",
    "postcss": "^8.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
