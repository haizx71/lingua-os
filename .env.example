# LINGUA OS environment template
APP_ENV=development
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend-only secret. NEVER expose with NEXT_PUBLIC_ prefix or pass to frontend browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only HMAC key, at least 32 random bytes. Never expose with a frontend public prefix.
REVIEW_CURSOR_SECRET=

# Frontend Public Browser Configuration (Safe for client-side exposure)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=
