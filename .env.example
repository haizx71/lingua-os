# LINGUA OS environment template
APP_ENV=development
DATABASE_URL=
SUPABASE_URL=

# Supabase Keys (Preferred modern naming; legacy SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY also supported)
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (Admin API user provisioning / teardown). NEVER expose with NEXT_PUBLIC_ prefix or pass to frontend browser code.
SUPABASE_SECRET_KEY=

# Legacy key aliases (supported for backward compatibility)
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Server-only HMAC key, at least 32 random bytes. Never expose with a frontend public prefix.
REVIEW_CURSOR_SECRET=

# Server-only comma-separated Supabase actor UUID allowlist for the bounded owner Admin API.
LINGUA_ADMIN_USER_IDS=

# Frontend Public Browser Configuration (Safe for client-side exposure)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=

# Next.js server-only proxy origin (staging/production; never NEXT_PUBLIC_)
API_INTERNAL_URL=
