{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "note": "Authoritative API-facing enum registry for LINGUA OS MVP v1. Internal database workflow values that are not exposed to product clients are intentionally omitted.",
  "concept_status": ["unseen", "discovered", "learning", "familiar", "active", "mastered", "weak", "forgotten"],
  "learning_activity_type": ["review", "read", "listen", "learn"],
  "review_rating": ["again", "hard", "good", "easy"],
  "review_exercise_mode": ["self_recall", "multiple_choice", "typing", "cloze", "listening"],
  "memory_state": ["new", "learning", "review", "relearning"],
  "competence_dimension": ["recognition", "listening", "production"],
  "learning_goal": ["communication", "work", "travel", "basics", "academic"],
  "language_profile_status": ["active", "paused", "archived"],
  "confidence_band": ["low", "medium", "high"],
  "assessment_status": ["in_progress", "completed", "abandoned"],
  "assessment_domain": ["vocabulary_recognition", "grammar_in_context", "reading_comprehension", "listening_comprehension"],
  "starting_level_band": ["A0", "A1", "A2", "B1"],
  "today_plan_status": ["draft", "active", "completed", "expired"],
  "today_activity_status": ["pending", "completed", "skipped"],
  "today_reason_code": ["FSRS_DUE", "WEAK_RECOGNITION", "WEAK_LISTENING", "LOW_PRODUCTION_EVIDENCE", "CONTENT_FIT", "RECENT_EXPOSURE", "NEW_CONCEPT_BUDGET"],
  "content_type": ["article", "story", "dialogue", "lesson", "transcript"],
  "reader_exposure_type": ["read", "listen", "lookup"],
  "reader_content_level": ["A0", "A1", "A2", "B1"],
  "content_segment_type": ["sentence", "paragraph", "dialogue_turn", "caption"],
  "library_item_type": ["content", "sentence", "concept"],
  "content_quality_status": ["raw", "normalized", "review_pending", "approved", "rejected"],
  "admin_content_status": ["raw", "normalized", "enriched", "reviewed", "published", "quarantined", "retired"]
}
